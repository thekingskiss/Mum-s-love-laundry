PORT=4000

# Set to "production" when deployed. Controls two safety checks: the app
# refuses to start with a missing/weak JWT_SECRET, and the forgot-password
# endpoint stops ever echoing the reset link back in its response (that
# fallback only exists so the flow is testable locally without SMTP set up).
NODE_ENV=development

# Local PostgreSQL connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=mums_love_laundry
DB_PASSWORD=your-postgres-password
DB_PORT=5432

# JWT signing secret — use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Comma-separated list of origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:5173

# Default daily order cap used when a date has no explicit capacity row.
MAX_DAILY_CAPACITY=50

# Optional — email notifications on order status changes. Leave unset to
# no-op (logs to console instead of sending).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Optional — SMS notifications on order status changes. Leave unset to no-op.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional — where contact-form submissions are emailed to. Falls back to
# SMTP_USER if unset; if neither is set, submissions are still stored in
# contact_messages and visible under Staff -> Messages.
CONTACT_EMAIL=

# Optional — enables online payments (Pay Now / staff payment links) via
# Paystack. Leave unset and the payment-initialize endpoint responds 503.
# Use a test secret key (sk_test_...) until you're ready to go live.
PAYSTACK_SECRET_KEY=
