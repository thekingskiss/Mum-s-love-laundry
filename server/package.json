{
  "name": "mums-love-laundry-server",
  "version": "3.0.0",
  "description": "Backend API for Mum's Love Laundry (Eastern Region, Ghana) — local PostgreSQL + JWT auth",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "worker": "node worker.js",
    "avatars:migrate": "node migrate-avatars-to-cloudinary.js",
    "db:migrate": "node db/migrate.js",
    "dev": "node --watch-path=./config --watch-path=./controllers --watch-path=./middleware --watch-path=./routes --watch-path=./services --watch-path=./utils --watch-path=server.js server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "twilio": "^5.3.4"
  },
  "devDependencies": {
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
